generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  MENTOR
  STUDENT
}

enum SubscriptionTier {
  BASIC
  PRO
}

enum TradeDirection {
  LONG
  SHORT
}

enum Symbol {
  NQ
  ES
  BTC
  XAU
  GC
  CL
  EURUSD
  OTHER
}

enum Killzone {
  ASIA
  LONDON
  NY_AM
  NY_PM
  OFF_HOURS
}

enum CyclePhase {
  CYCLE_1
  CYCLE_2
  CYCLE_3
  OFF_CYCLE
}

enum AlertType {
  MENTOR_COMMENT
  SYSTEM
  BILLING
  TRADOVATE_SYNC
}

enum TradeSource {
  MANUAL
  TRADOVATE
}

enum TradovateEnv {
  LIVE
  DEMO
}

/// How a Tradovate account was linked. OAuth never gives us the trader's password.
enum TradovateAuthMethod {
  CREDENTIALS
  OAUTH
}

// ─── JK model taxonomy ────────────────────────────────────────────────────────
// The three levels the entry-reason analysis needs kept apart: one primary setup
// per trade, many confluences, one trigger. A flat tag list is what made the same
// reason show up in both the best and worst lists.

enum SetupFamily {
  LIQUIDITY_SWEEP
  SMT
}

enum LiquiditySource {
  ASIA_HIGH
  ASIA_LOW
  LONDON_HIGH
  LONDON_LOW
  PDH
  PDL
  PWH
  PWL
  PMH
  PML
  OTHER
}

enum EntryTrigger {
  FVG
  IFVG
  CISD
}

enum EntryTimeframe {
  M1
  M3
  M5
}

enum ContextTimeframe {
  M5
  M15
  H1
  H4
  H6
  D1
  W1
}

enum TradeGrade {
  A
  B
  C
}

// ─── Execution & state ────────────────────────────────────────────────────────

enum ExitTrigger {
  TARGET
  STOP
  MANUAL_EARLY
  TRAIL
  TIME_STOP
  PANIC
  END_OF_DAY
}

enum EntryTiming {
  EARLY
  ON_TIME
  LATE
  CHASED
}

/// Replaces the free-text `emotionalState`, which could not be aggregated.
enum EmotionalState {
  CALM
  FOCUSED
  ANXIOUS
  FOMO
  REVENGE
  OVERCONFIDENT
  BORED
  TIRED
  PRESSURED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  passwordHash         String?
  name                 String?
  image                String?
  role                 Role             @default(STUDENT)
  subscriptionTier     SubscriptionTier @default(BASIC)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  isActive             Boolean          @default(true)
  trialEndsAt          DateTime?
  subscriptionStatus   String           @default("trial")

  mentorId String?
  mentor   User?   @relation("MentorStudents", fields: [mentorId], references: [id])
  students User[]  @relation("MentorStudents")

  accounts         Account[]
  sessions         Session[]
  trades           Trade[]
  mentorComments   MentorComment[]   @relation("MentorComments")
  studentComments  MentorComment[]   @relation("StudentComments")
  alerts           Alert[]
  backtestSessions BacktestSession[]
  tradovateAccount TradovateAccount?
  tradingPlan      TradingPlan?
  goals            Goal[]
  journals         DailyJournal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Trade {
  id             String         @id @default(cuid())
  userId         String
  symbol         Symbol
  direction      TradeDirection
  entryPrice     Decimal        @db.Decimal(12, 5)
  exitPrice      Decimal?       @db.Decimal(12, 5)
  entryTime      DateTime
  exitTime       DateTime?
  pnl            Decimal?       @db.Decimal(12, 2)
  rrAchieved     Decimal?       @db.Decimal(6, 2)
  rrPlanned      Decimal?       @db.Decimal(6, 2)
  isBacktest     Boolean        @default(false)
  screenshotUrl  String?
  notes          String?        @db.Text
  chartImages    String?        @db.Text // JSON: { daily?: string, h4?: string, h1?: string, m15?: string } base64 or URLs
  selfRating     Int?
  emotionalState String?

  killzone   Killzone?
  cyclePhase CyclePhase?

  // ─── Risk & sizing ──────────────────────────────────────────────────────────
  // Without stopPrice there is no true R, no MAE in R and no way to tell a moved
  // stop from a planned one. Without riskAmount the model's dollar caps and the
  // risk-consistency metric cannot be evaluated at all.
  stopPrice   Decimal? @db.Decimal(12, 5)
  targetPrice Decimal? @db.Decimal(12, 5)
  quantity    Int?
  riskAmount  Decimal? @db.Decimal(12, 2) // planned dollar risk at entry
  fees        Decimal? @db.Decimal(10, 2)

  // ─── Excursion ──────────────────────────────────────────────────────────────
  // Computed from Tradovate intra-trade price data where available; otherwise
  // entered by hand. Unlocks exit efficiency, stop width and "left on the table".
  maeR Decimal? @db.Decimal(6, 2)
  mfeR Decimal? @db.Decimal(6, 2)

  // ─── JK model taxonomy ──────────────────────────────────────────────────────
  setupFamily     SetupFamily?
  liquiditySource LiquiditySource?
  mssConfirmed    Boolean?
  entryTrigger    EntryTrigger?
  entryTimeframe  EntryTimeframe?
  fvgContextTf    ContextTimeframe?
  cisdRetested    Boolean? // CISD entries must wait for the retest
  grade           TradeGrade?

  // ─── Execution ──────────────────────────────────────────────────────────────
  exitTrigger  ExitTrigger?
  entryTiming  EntryTiming?
  movedStop    Boolean?
  addedToLoser Boolean?

  // ─── Discipline — computed by lib/jk-rules.ts, cached here ──────────────────
  // `followedPlan` is derived, not self-reported: seven of the model's nine rules
  // are decided from entry time, risk and target alone.
  followedPlan   Boolean?
  ruleViolations String?   @db.Text // JSON: RuleViolation[]
  rulesCheckedAt DateTime?

  // ─── State ──────────────────────────────────────────────────────────────────
  // `emotionalState` (String) is kept for existing rows; new entries use `emotion`.
  emotion     EmotionalState?
  focusRating Int? // 1-5

  // Tradovate integration
  source         TradeSource @default(MANUAL)
  externalFillId String?     @unique
  needsReview    Boolean     @default(false)

  // Claude-based deep notes analysis (structured extraction)
  notesAnalysis      String?   @db.Text // JSON: timeframes, confluences, sessions, instruments, summary_ar, ...
  notesAnalysisAt    DateTime?
  notesAnalysisModel String?

  backtestSessionId String?
  backtestSession   BacktestSession? @relation(fields: [backtestSessionId], references: [id])

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryReasons TradeEntryReason[]
  comments     MentorComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entryTime])
  @@index([userId, isBacktest])
  @@map("trades")
}

model EntryReason {
  id       String @id @default(cuid())
  category String
  name     String @unique

  tradeReasons TradeEntryReason[]

  @@map("entry_reasons")
}

model TradeEntryReason {
  tradeId       String
  entryReasonId String

  trade       Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  entryReason EntryReason @relation(fields: [entryReasonId], references: [id])

  @@id([tradeId, entryReasonId])
  @@map("trade_entry_reasons")
}

model MentorComment {
  id        String @id @default(cuid())
  tradeId   String
  mentorId  String
  studentId String
  body      String @db.Text

  trade   Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  mentor  User  @relation("MentorComments", fields: [mentorId], references: [id])
  student User  @relation("StudentComments", fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  @@map("mentor_comments")
}

model Alert {
  id      String    @id @default(cuid())
  userId  String
  type    AlertType
  message String
  isRead  Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("alerts")
}

model TradovateAccount {
  id                  String              @id @default(cuid())
  userId              String              @unique
  env                 TradovateEnv        @default(LIVE)
  /// How this account was linked. OAuth accounts carry a token and nothing else.
  authMethod          TradovateAuthMethod @default(CREDENTIALS)
  // Encrypted credentials (AES-256-GCM, format: iv:tag:ciphertext hex).
  // Null for OAuth accounts — we never receive those secrets at all.
  usernameEnc         String?             @db.Text
  passwordEnc         String?             @db.Text
  cidEnc              String?             @db.Text
  secretEnc           String?             @db.Text
  appId               String?
  deviceId            String?
  // Session tokens
  accessToken         String?             @db.Text
  mdAccessToken       String?             @db.Text
  refreshTokenEnc     String?             @db.Text
  tokenExpiresAt      DateTime?
  // Sync state
  isActive            Boolean             @default(true)
  lastSyncAt          DateTime?
  lastSyncStatus      String? // "ok" | "error: ..."
  lastErrorAt         DateTime?
  lastErrorMessage    String?             @db.Text
  importedTradesCount Int                 @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tradovate_accounts")
}

model BacktestSession {
  id          String   @id @default(cuid())
  userId      String
  name        String
  symbol      Symbol
  startDate   DateTime
  endDate     DateTime
  totalTrades Int      @default(0)
  winRate     Decimal? @db.Decimal(5, 2)
  avgRR       Decimal? @db.Decimal(6, 2)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  createdAt DateTime @default(now())

  @@map("backtest_sessions")
}

// ─── Day-trader features ───────────────────────────────────────────────────────

model TradingPlan {
  id                 String   @id @default(cuid())
  userId             String   @unique
  allowedSessions    String?  @db.Text // JSON: ["NY_AM","LONDON",...]
  allowedSymbols     String?  @db.Text // JSON: ["NQ","ES",...]
  maxTradesPerDay    Int?
  maxDailyLossUsd    Decimal? @db.Decimal(10, 2)
  maxRiskPerTradeUsd Decimal? @db.Decimal(10, 2)
  minRR              Decimal? @db.Decimal(4, 2)
  rules              String?  @db.Text // JSON: [{ text, active }]
  notes              String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trading_plans")
}

model Goal {
  id        String    @id @default(cuid())
  userId    String
  metric    String // "PNL" | "TRADE_COUNT" | "WIN_RATE" | "DISCIPLINE"
  period    String // "DAILY" | "WEEKLY" | "MONTHLY"
  target    Decimal   @db.Decimal(12, 2)
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@map("goals")
}

model DailyJournal {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  disciplineRating Int? // 1-5
  mood             String?
  followedPlan     Boolean?
  overtraded       Boolean?
  reflection       String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_journals")
}

model EconomicEvent {
  id        String   @id @default(cuid())
  date      DateTime
  currency  String
  title     String
  impact    String // "HIGH" | "MEDIUM" | "LOW"
  actual    String?
  forecast  String?
  previous  String?
  fetchedAt DateTime @default(now())

  @@unique([date, currency, title])
  @@index([date])
  @@map("economic_events")
}
